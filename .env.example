# Consolidated configuration reference. The quickstart uses the process-specific
# .env.restate.example and .env.web.example files to limit secret exposure.

# GitHub App identity
GITHUB_APP_ID=123456
GITHUB_INSTALLATION_ID=12345678
GITHUB_PRIVATE_KEY_PATH=/absolute/path/to/github-app.private-key.pem
# Alternatively, set GITHUB_PRIVATE_KEY to the PEM with newlines escaped as \n.
GITHUB_USER_PAT=github_pat_replace_me
GITHUB_MERGE_METHOD=squash
GITHUB_WEBHOOK_SECRET=replace-with-a-long-random-value
GITHUB_API_URL=https://api.github.com

# Single-user dashboard login
DASHBOARD_USERNAME=dependaboard
DASHBOARD_PASSWORD=replace-with-a-long-random-value

# Shared queryable projection. Use libsql://... and a token for Turso.
LIBSQL_URL=data/dependaboard.db
LIBSQL_AUTH_TOKEN=

# Restate local defaults
RESTATE_INGRESS_URL=http://127.0.0.1:8080
# On native Linux, replace 127.0.0.1 with the default Docker bridge gateway.
RESTATE_SERVICE_ADDRESS=127.0.0.1:9080
# Set for authenticated Restate Cloud ingress. RESTATE_API_KEY is also accepted.
RESTATE_AUTH_TOKEN=

# Durable synchronization policy
SYNC_DEBOUNCE_SECONDS=20
RECONCILE_INTERVAL_SECONDS=3600

RUST_LOG=info

# This file is sourced by a POSIX shell. Keep values quoted.

# GitHub App identity and GitHub mutations
GITHUB_APP_ID='123456'
GITHUB_INSTALLATION_ID='12345678'
GITHUB_PRIVATE_KEY_PATH="${HOME}/.config/dependaboard/github-app.pem"
GITHUB_USER_PAT='github_pat_replace_me'
GITHUB_MERGE_METHOD='squash'
GITHUB_API_URL='https://api.github.com'

# PAT identity
DASHBOARD_USERNAME='your-github-login'

# Shared queryable projection
LIBSQL_URL='data/dependaboard.db'
LIBSQL_AUTH_TOKEN=''

# Local Restate
RESTATE_INGRESS_URL='http://127.0.0.1:8080'
# Docker Desktop can normally reach a loopback listener. On native Linux,
# replace 127.0.0.1 with the default Docker bridge gateway documented in README.
RESTATE_SERVICE_ADDRESS='127.0.0.1:9080'
RESTATE_AUTH_TOKEN=''

# Durable synchronization policy
SYNC_DEBOUNCE_SECONDS='20'
RECONCILE_INTERVAL_SECONDS='3600'

RUST_LOG='info'
